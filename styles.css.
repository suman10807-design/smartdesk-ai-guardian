
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #07111f;
  --panel: #101e30;
  --panel-light: #15263b;
  --blue: #36c9ff;
  --blue-dark: #1689d0;
  --text: #f3f8ff;
  --muted: #91a4ba;
  --green: #37dfa0;
  --border: rgba(135, 180, 220, .14);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 0%, #102d4c 0%, transparent 48%),
    var(--bg);
  color: var(--text);
  font-family: Inter, sans-serif;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
  transition: .2s ease;
}

button:hover {
  transform: translateY(-2px);
  filter: brightness(1.12);
}

.app-shell {
  max-width: 1250px;
  margin: auto;
  padding: 24px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 0 25px;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  text-decoration: none;
  font-weight: 800;
  letter-spacing: 1px;
}

.brand small {
  display: block;
  color: var(--blue);
  font-size: 10px;
  letter-spacing: 3px;
  margin-top: 4px;
}

.brand-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: #06121f;
  background: linear-gradient(135deg, #8ae4ff, #1689d0);
  font-size: 23px;
  font-weight: 900;
}

.guardian-status {
  color: var(--green);
  font-size: 11px;
  letter-spacing: 1px;
  font-weight: 700;
}

.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-right: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px var(--green);
}

.dashboard {
  padding-top: 40px;
}

.welcome {
  margin-bottom: 30px;
}

.eyebrow {
  color: var(--blue);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-bottom: 10px;
}

.welcome h1 {
  font-size: clamp(34px, 5vw, 55px);
  letter-spacing: -2px;
  margin-bottom: 10px;
}

.welcome h1 span {
  color: var(--blue);
}

.welcome > p:last-child,
.muted {
  color: var(--muted);
  font-size: 13px;
}

.timer-card,
.feature-card,
.assistant-card,
.activity-card {
  background: linear-gradient(145deg, var(--panel-light), var(--panel));
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 26px;
  box-shadow: 0 15px 45px rgba(0, 0, 0, .16);
}

.timer-card {
  text-align: center;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-align: left;
  gap: 12px;
}

.section-heading h2,
.assistant-card h2,
.activity-card h2 {
  font-size: 19px;
}

.live-label {
  font-size: 10px;
  color: var(--green);
  letter-spacing: 1px;
}

.timer-ring {
  width: 245px;
  height: 245px;
  border-radius: 50%;
  margin: 35px auto;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle, var(--panel) 65%, transparent 67%),
    conic-gradient(var(--blue) 0deg, #17628f 240deg, #1c344c 240deg);
  box-shadow: 0 0 35px rgba(54, 201, 255, .13);
}

.timer-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.timer-content span {
  color: var(--blue);
  font-size: 10px;
  letter-spacing: 2px;
}

.timer-content strong {
  font-size: 36px;
  font-variant-numeric: tabular-nums;
}

.timer-content small {
  color: var(--muted);
  font-size: 11px;
}

.timer-settings {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
  margin-bottom: 22px;
}

.timer-settings label {
  display: flex;
  flex-direction: column;
  text-align: left;
  gap: 8px;
  color: var(--muted);
  font-size: 11px;
}

input {
  background: #091626;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px;
  outline: none;
  min-width: 90px;
}

input:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(54, 201, 255, .1);
}

.action-buttons,
.break-controls,
.chat-controls {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.small-btn {
  border: 0;
  border-radius: 10px;
  padding: 12px 18px;
  font-weight: 700;
  font-size: 12px;
}

.primary-btn {
  background: linear-gradient(135deg, #36c9ff, #1689d0);
  color: #06121f;
}

.secondary-btn,
.small-btn {
  background: #1b3048;
  color: var(--text);
  border: 1px solid var(--border);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 22px 0;
}

.feature-card {
  min-width: 0;
}

.feature-icon {
  display: block;
  font-size: 25px;
  color: var(--blue);
  margin-bottom: 17px;
}

.feature-card h3 {
  margin: 7px 0 16px;
  font-size: 16px;
}

.feature-card .muted {
  margin-top: 8px;
}

.break-controls {
  justify-content: flex-start;
}

.break-controls input {
  width: 75px;
  min-width: 0;
}

#cameraPreview {
  display: block;
  width: 100%;
  max-width: 280px;
  margin-top: 15px;
  border-radius: 12px;
}

#cameraPreview[hidden] {
  display: none;
}

.assistant-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.assistant-card > div:first-child {
  max-width: 420px;
}

#assistantReply {
  color: var(--muted);
  margin-top: 10px;
  font-size: 13px;
}

.chat-controls input {
  min-width: 180px;
  flex: 1;
}

.activity-card {
  margin-top: 20px;
}

.activity-card h2 {
  margin-bottom: 15px;
}

.activity-card ul {
  list-style: none;
  color: var(--muted);
  font-size: 12px;
}

.activity-card li {
  padding: 9px 0;
  border-bottom: 1px solid var(--border);
}

footer {
  text-align: center;
  color: #647b94;
  font-size: 9px;
  letter-spacing: 2px;
  padding: 35px 0 15px;
}

@media (max-width: 650px) {
  .app-shell {
    padding: 16px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .timer-card,
  .feature-card,
  .assistant-card,
  .activity-card {
    padding: 20px;
  }

  .timer-ring {
    width: 215px;
    height: 215px;
  }

  .timer-content strong {
    font-size: 29px;
  }

  .assistant-card {
    align-items: stretch;
  }

  .chat-controls {
    justify-content: stretch;
  }
}
